<IfModule mod_filter.c>
	<IfModule mod_deflate.c>
		AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/manifest+json image/svg+xml
	</IfModule>
</IfModule>

<IfModule mod_headers.c>
	<FilesMatch "\.(?:css|js)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<Files "index.html">
		Header set Cache-Control "no-cache"
	</Files>
</IfModule>
